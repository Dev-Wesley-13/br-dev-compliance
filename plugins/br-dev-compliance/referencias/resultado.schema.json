{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BR Dev Compliance — resultado de auditoria 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "generated_at", "mode", "status", "review_level", "scope", "coverage", "sources", "findings", "decision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["plano", "entrega", "repositorio"]},
    "status": {"enum": ["parcial", "concluida_no_escopo", "nao_executada"]},
    "review_level": {"const": "tecnica_sem_revisao_juridica_independente"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["examined", "excluded", "limitations"],
      "properties": {
        "examined": {"type":"array","maxItems":30,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":300,"pattern":"^[^:\\r\\n]+$","description":"Somente plano ou caminho relativo canônico, sem repo:, linha, comentário ou descrição. Exemplo: p1-licenca-MIT.txt"}},
        "excluded": {"$ref": "#/$defs/texts"},
        "limitations": {"$ref": "#/$defs/texts"}
      }
    },
    "coverage": {
      "type": "array", "maxItems": 13,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "status", "rationale"],
        "properties": {
          "check_id": {"$ref": "#/$defs/check_id"},
          "status": {"enum": ["indicio", "sem_indicio", "insuficiente", "nao_aplicavel", "nao_examinado"]},
          "rationale": {"$ref": "#/$defs/text"}
        }
      }
    },
    "sources": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "location", "status", "accessed_at", "version", "attempts", "fragments", "limitation"],
        "properties": {
          "id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
          "kind": {"enum": ["norma", "ato_regulatorio", "guia", "licenca", "metadados"]},
          "location": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(https://|repo:)"},
          "status": {"enum": ["consultada", "indisponivel", "nao_consultada"]},
          "accessed_at": {"type": ["string", "null"], "format": "date-time"},
          "version": {"type": ["string", "null"], "maxLength": 300},
          "edition_kind": {"enum": ["original", "compilado", "atualizado", null]},
          "last_amendment": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
          "attempts": {"type": "integer", "minimum": 0, "maximum": 3, "description":"Número de tentativas EXTERNAS; fonte repo: usa zero mesmo quando lida."},
          "fragments": {
            "type": "array", "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["locator", "excerpt"],
              "properties": {
                "locator": {"type": "string", "minLength": 1, "maxLength": 120},
                "excerpt": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "limitation": {"type": ["string", "null"], "maxLength": 1200}
        }
      }
    },
    "findings": {
      "type": "array", "maxItems": 26,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "check_id", "confidence", "impact", "summary", "evidence", "rationale", "citations", "missing_context", "suggestion"],
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
          "check_id": {"$ref": "#/$defs/check_id"},
          "confidence": {"enum": ["forte", "fraco", "insuficiente"]},
          "impact": {"enum": ["baixo", "medio", "alto"]},
          "summary": {"$ref": "#/$defs/text"},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["location", "description"],
              "properties": {"location": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}}
            }
          },
          "rationale": {"$ref": "#/$defs/text"},
          "citations": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "locator", "location_status", "support_status", "claim_kind", "rationale"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^S-[0-9]{3}$"},
                "locator": {"type": "string", "minLength": 1, "maxLength": 120},
                "location_status": {"enum": ["localizada", "nao_localizada", "nao_consultada"]},
                "support_status": {"enum": ["sustenta", "nao_sustenta", "pendente"]},
                "claim_kind": {"enum": ["obrigacao", "orientacao", "licenciamento"]},
                "rationale": {"$ref": "#/$defs/text"}
              }
            }
          },
          "missing_context": {"$ref": "#/$defs/texts"},
          "suggestion": {"$ref": "#/$defs/text"}
        }
      }
    },
    "decision": {"enum": ["pendente", "continuar", "corrigir", "parar"]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 1200},
    "texts": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "check_id": {"enum": ["LGPD-01", "LGPD-02", "LGPD-03", "LGPD-04", "LGPD-05", "LGPD-06", "LGPD-07", "LGPD-08", "LGPD-09", "LIC-01", "LIC-02", "LIC-03", "LIC-04"]}
  }
}
