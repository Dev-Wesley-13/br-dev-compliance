{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BR Dev Compliance — envelope local 2",
  "description":"Contrato documental. O helper valida envelope, digest, raiz, resultado 1.0 e transições; checksum não autentica o autor.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","repo_id","root_binding","payload","digest"],
  "properties":{
    "schema":{"const":2},
    "id":{"type":"string","pattern":"^(aud|dec)-[a-f0-9]{32}$"},
    "repo_id":{"type":"string","pattern":"^repo-[a-f0-9]{32}$"},
    "root_binding":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "payload":{
      "oneOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["saved_at","audit","baseline","issues","reassess"],
          "properties":{
            "saved_at":{"type":"string","format":"date-time"},
            "audit":{"$ref":"resultado.schema.json"},
            "baseline":{
              "type":"object","additionalProperties":false,"required":["captured_at","snapshot"],
              "properties":{
                "captured_at":{"type":"string","format":"date-time"},
                "snapshot":{
                  "type":"object","additionalProperties":false,
                  "required":["root_binding","context_hash","plan_hash","policy_hash","files","inventory_hash"],
                  "properties":{
                    "root_binding":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                    "context_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                    "plan_hash":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
                    "policy_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                    "inventory_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
                    "files":{"type":"array","minItems":1,"maxItems":20,"items":{
                      "type":"object","additionalProperties":false,"required":["path","hash"],
                      "properties":{"path":{"type":"string","minLength":1,"maxLength":300},"hash":{"type":"string","pattern":"^([a-f0-9]{64}|missing)$"}}
                    }}
                  }
                }
              }
            },
            "issues":{"type":"array","maxItems":20,"items":{
              "type":"object","additionalProperties":false,"required":["finding_id","issue_id"],
              "properties":{"finding_id":{"type":"string","pattern":"^F-[0-9]{3}$"},"issue_id":{"type":"string","pattern":"^iss-[a-f0-9]{32}$"}}
            }},
            "reassess":{"type":"array","maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^iss-[a-f0-9]{32}$"}}
          }
        },
        {
          "type":"object","additionalProperties":false,
          "required":["saved_at","issue_id","decision","statement"],
          "properties":{
            "saved_at":{"type":"string","format":"date-time"},
            "issue_id":{"type":"string","pattern":"^iss-[a-f0-9]{32}$"},
            "decision":{"enum":["continuar","corrigir","parar"]},
            "statement":{"type":"string","minLength":1,"maxLength":1200}
          }
        }
      ]
    }
  }
}
